<Window x:Class="MedReport.Client.Views.PinValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Otorisasi Akses IT" 
        SizeToContent="Height" 
        Width="360" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize" 
        WindowStyle="ToolWindow">

    <Grid Background="#F5F7FA" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Baris 0: Label -->
        <TextBlock Grid.Row="0" 
                   Text="Masukkan PIN Keamanan IT Rumah Sakit:" 
                   FontWeight="SemiBold" 
                   FontSize="12" 
                   Margin="0,0,0,10" 
                   Foreground="#333333"/>

        <!-- Baris 1: PasswordBox -->
        <PasswordBox x:Name="PbPin" 
                     Grid.Row="1" 
                     Height="30" 
                     FontSize="14" 
                     VerticalContentAlignment="Center" 
                     MaxLength="6"/>

        <!-- Baris 2: Tombol Aksi -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">
            <Button Content="Batal" 
                    Width="70" 
                    Height="30" 
                    Margin="0,0,10,0" 
                    Click="BtnCancel_Click"/>
            <Button Content="Verifikasi" 
                    Width="80" 
                    Height="30" 
                    Background="#007ACC" 
                    Foreground="White" 
                    FontWeight="SemiBold" 
                    Click="BtnVerify_Click" 
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>