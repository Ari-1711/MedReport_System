<UserControl x:Class="MedReport.Client.Views.SignatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MedReport.Client"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Tambahkan VerticalScrollBarVisibility="Auto" pada semua TextBox -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
            <TextBlock Text="Anamnesa :"/>
            <TextBox x:Name="TxtAnamnesa" 
                     MinHeight="80" 
                     MaxHeight="200" 
                     TextWrapping="Wrap" 
                     AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto" 
                     MaxLength="900" />
            <TextBlock Text="{Binding ElementName=TxtAnamnesa, Path=Text.Length, StringFormat='{}{0}/900', FallbackValue='0/900'}" 
               HorizontalAlignment="Right" Foreground="Gray" FontSize="11" Margin="0,2,5,0"/>
        </StackPanel>


        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
            <TextBlock Text="Hasil :"/>
            <TextBox x:Name="TxtHasil" 
                     MinHeight="80" 
                     MaxHeight="200" 
                     TextWrapping="Wrap" 
                     AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto" 
                     MaxLength="900" />

            <TextBlock Text="{Binding ElementName=TxtHasil, Path=Text.Length, StringFormat='{}{0}/900', FallbackValue='0/900'}" 
               HorizontalAlignment="Right" Foreground="Gray" FontSize="11" Margin="0,2,5,0"/>
        </StackPanel>


        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
            <TextBlock Text="Kesimpulan :"/>
            <TextBox x:Name="TxtKesimpulan" 
                     MinHeight="80" 
                     MaxHeight="200" 
                     TextWrapping="Wrap" 
                     AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto" 
                     MaxLength="900"/>

            <TextBlock Text="{Binding ElementName=TxtKesimpulan, Path=Text.Length, StringFormat='{}{0}/900', FallbackValue='0/900'}" 
               HorizontalAlignment="Right" Foreground="Gray" FontSize="11" Margin="0,2,5,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
            <TextBlock Text="Saran :"/>
            <TextBox x:Name="TxtSaran" 
                     MinHeight="80" 
                     MaxHeight="200" 
                     TextWrapping="Wrap" 
                     AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto" 
                     MaxLength="900"/>

            <TextBlock Text="{Binding ElementName=TxtSaran, Path=Text.Length, StringFormat='{}{0}/900', FallbackValue='0/900'}" 
               HorizontalAlignment="Right" Foreground="Gray" FontSize="11" Margin="0,2,5,0"/>
        </StackPanel>

        <!-- Perbaikan Proporsi Area Tanda Tangan dan Penamaan Event -->
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="5" HorizontalAlignment="Right">
            <TextBlock Text="Doctor's Signature:" Margin="0,15,0,2"/>
            <Border BorderBrush="#007ACC" BorderThickness="1">
                <!-- Ubah proporsi menjadi persegi panjang -->
                <InkCanvas Name="Sigpad" Height="120" Width="300" Background="White"/>
            </Border>
            <!-- Ubah nama event dari bawaan Button_Click menjadi BtnClearSignature_Click -->
            <Button Content="Clear" Click="BtnClearSignature_Click" Width="60" Margin="0,5,0,0" HorizontalAlignment="Right"/>
        </StackPanel>

    </Grid>
</UserControl>