<Window x:Name="tbnmedicalapp"
        x:Class="MedReport.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedReport.Client"
        Title="Endoscopy Report System" Height="600" Width="1000"
        Closing="tbnmedicalapp_Closing"
        xmlns:views="clr-namespace:MedReport.Client.Views">
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#007ACC" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="LogoContainer" Grid.Column="0" Margin="0,0,15,0" Visibility="Collapsed">
                    <Image x:Name="HospitalLogo" 
                           Width="80" Height="80" 
                           Stretch="Uniform"/>

                    <Button Content="X" x:Name="BtnDeleteLogo"
                            VerticalAlignment="Top" HorizontalAlignment="Right"
                            Background="#D9534F" Foreground="White" FontWeight="Bold"
                            FontSize="9" Width="20" Height="20" Margin="0,-6,-6,0" 
                            Click="BtnRemoveLogo_Click"/>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Import Logo"
                            HorizontalAlignment="Left" Margin="0,0,0,5" 
                            Click="BtnImportLogo_Click"/>
                    <TextBlock Text="Airway Management Report" Foreground="White"
                               FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="15,5">
                <views:PatientFormView x:Name="FormPasien" Margin="0,0,0,10"/>

                <views:ImageGridView x:Name="GaleriFoto" Margin="0,0,0,10"/>

                <views:SignatureView x:Name="TandaTangan" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Background="White">
            <ProgressBar x:Name="PgbLoading" 
                         Height="6" 
                         IsIndeterminate="True" 
                         Visibility="Collapsed" 
                         Background="#E0E0E0" 
                         Foreground="#007ACC"/>

            <UniformGrid Columns="3" Margin="15,10">
                <Button Content="Return" Margin="5" Height="40" FontSize="12"/>
                <Button Content="Save Template" Margin="5" Height="40" FontSize="12" Click="BtnSaveTemplate_Click"/>
                <Button Content="Generate Report" Margin="5" Height="40" FontSize="12" FontWeight="SemiBold"
                        Background="#007ACC" Foreground="White" Name="BtnGenerate" Click="BtnGenerate_Click"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>