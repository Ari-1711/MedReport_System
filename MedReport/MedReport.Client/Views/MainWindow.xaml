<Window x:Name="tbnmedicalapp"
        x:Class="MedReport.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedReport.Client"
        Title="Endoscopy Report System" Height="600" Width="1000"
        Closing="tbnmedicalapp_Closing"
        xmlns:views="clr-namespace:MedReport.Client.Views">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Use a Border to provide Padding -->
        <Border Grid.Row="0" Background="#007ACC" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="LogoContainer" Grid.Column="0" Margin="0,0,15,0" Visibility="Collapsed">

                    <Image x:Name="HospitalLogo" Grid.Column="0"
              Width="80" Height="80" Margin="0, 0, 15, 0"
              Stretch="Uniform"/>

                    <Button Content="X" x:Name="BtnDeleteLogo"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Background="Red" Foreground="White" FontWeight="Bold"
                    FontSize="8"
                    Width="18" Height="18" Margin="0, -8,-8,0" 
                    Click="BtnRemoveLogo_Click">
                    </Button>
                </Grid>


                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Import Logo"
                    HorizontalAlignment="Left" Margin="0, 0, 0, 5" 
                    Click="BtnImportLogo_Click"/>
                    <TextBlock Text="Airway Management Report" Foreground="White"
                      FontSize="20" FontWeight="Bold"/>
                </StackPanel>

            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <views:PatientFormView x:Name="FormPasien"/>
                <views:ImageGridView x:Name="GaleriFoto"/>
                <views:SignatureView x:Name="TandaTangan"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Background="White">
            <ProgressBar x:Name="PgbLoading" 
         Height="10" 
         IsIndeterminate="True" 
         Visibility="Collapsed" 
         Margin="15,0,15,0"/>

            <UniformGrid Grid.Row="2" Columns="3" Margin="10">
                <Button Content="Return" Margin="5" Height="40"/>
                <Button Content="Save Template" Margin="5" Height="40" Click="BtnSaveTemplate_Click"/>
                <Button Content="Generate Report" Margin="5" Height="40" Background="#007ACC" Foreground="White" Click="BtnGenerate_Click" Name="BtnGenerate"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
